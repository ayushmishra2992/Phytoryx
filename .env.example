# PHYTORYX environment variables. Copy values into your shell / hosting platform's settings; the backend does NOT read this file by itself.
# NEVER commit real values. Secrets must stay server-side (never in NEXT_PUBLIC_* variables).

# --- Backend (secret) ---------------------------------------------------------------------------------------------
# Free key from https://explore.openaq.org/register (one key per individual). Needed only for MEASURED air quality (OpenAQ).
OPENAQ_API_KEY=

# --- Backend (optional) -------------------------------------------------------------------------------------------
# PHYLLO_CORS_ORIGINS=https://your-frontend.example      # comma-separated extra browser origins; any localhost port is always allowed
# PHYLLO_LOAD_AQI_MODEL=1                                 # 0 = skip the legacy AQI model (saves memory; leaf-image AQI is withheld anyway)
# OPENAQ_RADIUS_M=25000                                   # station search radius in metres (OpenAQ v3 maximum 25000)
# OPENAQ_BASE_URL=https://api.openaq.org/v3
# OPENMETEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# OPENMETEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# PORT=7860                                               # container only (Dockerfile): port uvicorn listens on
# PHYLLO_RATE_LIMIT=30                                    # requests per window per client IP on the expensive /v2 routes (0 disables)
# PHYLLO_RATE_WINDOW_S=60
# PHYLLO_TRUST_PROXY=0                                    # 1 = use the first X-Forwarded-For address as the client (ONLY behind a trusted proxy)

# --- Frontend (public, baked in at build time) --------------------------------------------------------------------
# frontend/.env.local ->  NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
